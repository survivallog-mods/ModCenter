<Project Sdk="Microsoft.NET.Sdk">

  <!-- MC 壳（ModCenter v2 生命周期组件一）：永久冻结的 BepInEx patcher 引导壳。
       版本号 1.0.0 是 [PatcherPluginInfo] 的占位值，**不是独立版本线**——壳永不变更，
       只有壳与 ModCenter.dll 的接口签名（uninstalled.flag / selfupdate.flag / CleanupRunner.Run）
       发生变更时才需要随安装器更新本 dll。 -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MCShell</AssemblyName>
    <RootNamespace>MCShell</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>embedded</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>E:\SteamLibrary\steamapps\common\Survival Log\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Preloader.Core">
      <HintPath>E:\SteamLibrary\steamapps\common\Survival Log\BepInEx\core\BepInEx.Preloader.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
